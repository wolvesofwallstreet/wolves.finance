################################################################################
#
# Environment variables for dotenv
#
# Copy this file to a new file named .env and fill in the desired parameters.
# If the variable is set in the environment, it will override the value
# specified here.
#
# Do not commit .env to git.
#
################################################################################

# Your API key for Infura
# Obtain one at https://infura.io/
INFURA_API_KEY=

# Your API key for Etherscan
# Obtain one at https://etherscan.io/
ETHERSCAN_API_KEY=

# Wallet secrets used to define accounts for testing
DEPLOYER_WALLET=
MARKETING_WALLET=
TEAM_WALLET=
TEST_WALLET=
