{
  "name": "wolves.finance",
  "version": "1.0.0",
  "description": "DeFi meets gamification",
  "homepage": "https://wolvesofwallstreet.github.io",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.1.0"
  },
  "keywords": [
    "dapp",
    "decentralized",
    "defi",
    "finance",
    "gamification",
    "lending",
    "liquiditypooling",
    "marketmaking",
    "nonfungible",
    "semifungible"
  ],
  "scripts": {
    "audit": "audit-ci --moderate --package-manager yarn",
    "build": "react-scripts build",
    "clean": "rimraf artifacts build cache contracts/depends depends deployments node_modules src/abi",
    "compile": "hardhat compile",
    "create-metadata": "cd metadata && node create_metadata.ts",
    "depends": "make -C tools clean && make -C tools -j 4",
    "deploy": "gh-pages -b master -r https://github.com/wolvesofwallstreet/wolvesofwallstreet.github.io.git -d build",
    "format": "prettier --write . && eslint --fix .",
    "goerli:deploy": "hardhat --network goerli deploy",
    "goerli:export": "hardhat --network goerli export",
    "goerli:verify": "hardhat --network goerli etherscan-verify --solc-input",
    "hardhat:deploy": "hardhat --network hardhat deploy",
    "hardhat:export": "hardhat --network hardhat export",
    "kovan:deploy": "hardhat --network kovan deploy",
    "kovan:export": "hardhat --network kovan export",
    "kovan:verify": "hardhat --network kovan etherscan-verify --solc-input",
    "lint": "yarn lint-chain && yarn lint-app",
    "lint-app": "prettier --check . && eslint .",
    "lint-chain": "solhint 'contracts/interfaces/**/*.sol' 'contracts/src/**/*.sol' 'contracts/test/**/*.sol' --max-warnings 0",
    "local-node": "hardhat node --network hardhat",
    "local:deploy": "hardhat --network localhost deploy",
    "local:export": "hardhat --network localhost export",
    "postinstall": "bash tools/patch-depends.sh",
    "rinkeby:deploy": "hardhat --network rinkeby deploy",
    "rinkeby:export": "hardhat --network rinkeby export",
    "rinkeby:verify": "hardhat --network rinkeby etherscan-verify --solc-input",
    "ropsten:deploy": "hardhat --network ropsten deploy",
    "ropsten:export": "hardhat --network ropsten export",
    "ropsten:verify": "hardhat --network ropsten etherscan-verify --solc-input",
    "start": "react-scripts start",
    "test": "yarn test-chain && yarn test-app",
    "test-app": "react-scripts test --passWithNoTests",
    "test-chain": "ts-mocha --recursive --extension ts --require esm --require isomorphic-fetch || ([ $? -eq 139 ] && echo 'Segfault')"
  },
  "dependencies": {
    "@glidejs/glide": "^3.4.1",
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^11.1.0",
    "@testing-library/user-event": "^12.1.10",
    "@types/i18next": "^13.0.0",
    "@types/react-copy-to-clipboard": "^5.0.0",
    "@types/react-i18next": "^8.1.0",
    "@types/react-router-dom": "^5.1.7",
    "@walletconnect/web3-provider": "^1.3.1",
    "async": "^3.2.0",
    "bootstrap": "^4.5.3",
    "ethers": "^5.0.23",
    "flux": "^3.1.3",
    "gh-pages": "^3.1.0",
    "i18next": "^19.8.4",
    "i18next-browser-languagedetector": "^6.0.1",
    "react": "^17.0.1",
    "react-bootstrap": "^1.4.0",
    "react-bootstrap-icons": "^1.2.3",
    "react-copy-to-clipboard": "^5.0.3",
    "react-dom": "^17.0.1",
    "react-i18next": "^11.8.5",
    "react-router-dom": "^5.2.0",
    "react-scripts": "^4.0.2",
    "react-toastify": "^7.0.3",
    "walletlink": "^2.0.3",
    "web-vitals": "^0.2.4",
    "web3modal": "^1.9.2"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.0.1",
    "@nomiclabs/hardhat-etherscan": "^2.1.0",
    "@openzeppelin/contracts": "^3.4.1",
    "@types/async": "^3.2.5",
    "@types/chai": "^4.2.14",
    "@types/flux": "^3.1.9",
    "@types/glidejs__glide": "^3.4.0",
    "@types/mocha": "^8.0.4",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@typescript-eslint/eslint-plugin": "^4.9.0",
    "@typescript-eslint/parser": "^4.9.0",
    "audit-ci": "^3.1.1",
    "chai": "^4.2.0",
    "dotenv-defaults": "^2.0.1",
    "eslint": "^7.14.0",
    "eslint-plugin-simple-import-sort": "^6.0.1",
    "esm": "^3.2.25",
    "ethereum-waffle": "^3.2.2",
    "ethers": "^5.0.23",
    "hardhat": "^2.0.8",
    "hardhat-abi-exporter": "^2.0.8",
    "hardhat-deploy": "git+https://github.com/juztamau5/hardhat-deploy.git#0.7.0-beta.44",
    "hardhat-deploy-ethers": "^0.3.0-beta.7",
    "isomorphic-fetch": "^3.0.0",
    "mocha": "^8.2.1",
    "prettier": "^2.2.1",
    "prettier-plugin-pkg": "^0.8.0",
    "prettier-plugin-solidity": "^1.0.0-beta.1",
    "rimraf": "^3.0.2",
    "solhint": "^3.3.2",
    "solhint-plugin-prettier": "^0.0.5",
    "ts-mocha": "^8.0.0",
    "ts-node": "^9.0.0",
    "typescript": "^4.1.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "bundleDependencies": false,
  "homepage_orig": "https://wolvesofwallstreet.github.io",
  "target": "web"
}
