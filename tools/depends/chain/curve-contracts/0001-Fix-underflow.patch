Subject: [PATCH 1/3] Fix underflow

---
 contracts/pools/y/DepositY.vy | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/contracts/pools/y/DepositY.vy b/contracts/pools/y/DepositY.vy
index 5b8972a..21613fa 100644
--- a/contracts/pools/y/DepositY.vy
+++ b/contracts/pools/y/DepositY.vy
@@ -268,7 +268,9 @@ def _calc_withdraw_one_coin(_token_amount: uint256, i: int128, rates: uint256[N_
         b_ideal: uint256 = xp[j] * D1 / D0
         b_expected: uint256 = xp[j]
         if j == i:
-            b_expected -= S * (D0 - D1) / D0
+            temp: uint256 = S * (D0 - D1) / D0
+            if temp <= b_expected:
+                b_expected -= temp
         if b_ideal >= b_expected:
             dx_expected += (b_ideal - b_expected)
         else:
